// Bare `simple` test room in the free editor camera: game scripts initialized,
// the player at the origin and the camera looking at it from behind. Scenarios
// that need gameplay input include `test_room_player_pov` instead.
[
    TestWorld(name: "simple"),
    ZenginScriptStartup(world: "NEWWORLD/NEWWORLD", clean_world: false),
    ZenginSpawnPlayerCharacter(translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0)),
    SetCameraLocation(translation: (0.0, 0.0, 0.0), rotation: (-30.0, 0.0, 0.0)),
    Wait(frame_dt: 50),
]
