[
    // Setup
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginEquipWeapon(item: "itmw_1h_mil_sword"),
    ZenginSetPlayerOneHandSkill(skill: 1),
    ZenginSetDebugNpc(name: "hero"),
    Wait(frame_dt: 100),

    // Act
    TestClearLogBuffer,
    Press(action: Gameplay(Interact)),
    Wait(frame_dt: 60),
    Release(action: Gameplay(Interact)),
    Wait(frame_dt: 150),

    // Assert
    TestLogExists(regex: "current=HUMANS_1HST1-S_1HATTACK"),

    // Act
    ZenginSetPlayerOneHandSkill(skill: 2),
    Wait(frame_dt: 20),
    TestClearLogBuffer,
    Press(action: Gameplay(Interact)),
    Wait(frame_dt: 60),
    Release(action: Gameplay(Interact)),
    Wait(frame_dt: 150),

    // Assert
    TestLogExists(regex: "current=HUMANS_1HST2-S_1HATTACK"),

    // Act
    ZenginSetPlayerOneHandSkill(skill: 0),
    Wait(frame_dt: 20),
    TestClearLogBuffer,
    Press(action: Gameplay(Interact)),
    Wait(frame_dt: 60),
    Release(action: Gameplay(Interact)),
    Wait(frame_dt: 150),

    // Assert
    TestLogExists(regex: "current=HUMANS-S_1HATTACK"),

    ExitGame,
]
