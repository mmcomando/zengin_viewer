[
    // Setup
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginEquipWeapon(item: "itmw_2h_sld_axe"),
    ZenginSetDebugNpc(name: "hero"),
    Wait(frame_dt: 100),

    // Act
    TestClearLogBuffer,
    PressRelease(action: Gameplay(AttackLeft)),
    Wait(frame_dt: 60),

    // Assert
    TestLogExists(regex: "current=HUMANS-T_2HATTACKL"),
    TestLogNotExists(regex: "current=HUMANS-T_1HATTACK"),

    ExitGame,
]
