// Wolf combat flow: a hand spawned wolf in the bare test room.
//
//   1. far away (outside the 15 m perception range) the wolf stays passive
//   2. stepping to 8 m makes it warn (`T_WARN`, `zs_mm_threatenenemy`)
//   3. the 4 s threat timeout starts the attack (`zs_mm_attack`, `AI_Attack`)
//   4. the attack action chases the player and swings (`S_FISTATTACK`)
[
    TestWorld(name: "simple"),
    ZenginScriptStartup(world: "NEWWORLD/NEWWORLD", clean_world: false),
    ZenginSpawnPlayerCharacter(frame: 10, translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSpawnNpc(frame: 20, name: "wolf", translation: (0.0, 0.0, -20.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSetDebugNpc(frame: 30, name: "wolf"),
    // Side view onto the player/wolf line along the Z axis.
    SetCameraLocation(
        frame: 40,
        translation: (11.0, 3.5, -15.0),
        rotation: (-14.0, 90.0, 0.0),
    ),

    // 1) Far: no combat state may start inside the observed window.
    TestClearLogBuffer(frame: 150),
    TestLogNotExists(frame: 185, regex: "AI_StartState\\(zs_mm_(threatenenemy|attack)\\)"),
    TestScreenshot(frame: 186, path: "00_far.png"),

    // 2) Step into perception range (8 m, outside the 7 m attack range).
    TeleportPlayer(frame: 200, translation: (0.0, 0.0, -12.0), rotation: (0.0, 0.0, 0.0)),
    TestLogExists(frame: 230, regex: "AI_StartState\\(zs_mm_threatenenemy\\)"),
    TestLogExists(frame: 235, regex: "DebugNPC: animation .*WOLF-T_WARN"),
    TestScreenshot(frame: 280, path: "01_warning.png"),

    // 3) The threat timer expires and the wolf starts attacking.
    //
    // The state time reaches 4 s at the loop tick around frame 430; it then
    // runs the last meters before the first swing around frame 505.
    TestScreenshot(frame: 470, path: "02_attack_chase.png"),
    TestLogExists(frame: 500, regex: "AI_StartState\\(zs_mm_attack\\)"),
    TestLogExists(frame: 510, regex: "AI_Attack requested by npc"),
    TestLogExists(frame: 560, regex: "DebugNPC: animation .*WOLF-S_FISTATTACK"),
    TestScreenshot(frame: 565, path: "03_attack_swing.png"),

    ExitGame(frame: 600),
]
