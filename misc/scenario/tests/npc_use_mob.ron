[
    // Setup
    IncludeScenario(path: "/common/test_room_free_camera"),
    ZenginLoadWorldPrototypes(world: "NEWWORLD/NEWWORLD"),
    ZenginSpawnVob(
        visual: "BSANVIL_OC",
        translation: (0.0, 0.0, 0.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnNpc(
        name: "vlk_412_harad",
        translation: (0.0, 0.0, 1.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnVob(
        visual: "BAUMSAEGE_1",
        translation: (0.0, 0.0, -10.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnNpc(
        name: "vlk_462_thorben",
        translation: (0.0, 0.0, -9.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnVob(
        visual: "CHAIR_NW_NORMAL_01",
        translation: (0.0, 0.0, -20.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnNpc(
        name: "vlk_449_lares",
        translation: (0.0, 0.0, -19.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSetDebugNpc(name: "harad, thorben, lares"),
    TeleportPlayer(
        translation: (0.0, 0.0, 6.0),
        rotation: (0.0, 0.0, 0.0),
    ),

    // Act
    TestClearLogBuffer,
    ZenginNpcUseMob(name: "vlk_412_harad", scheme: "BSANVIL", state: 1),
    ZenginNpcUseMob(name: "vlk_462_thorben", scheme: "BAUMSAEGE", state: 1),
    ZenginNpcUseMob(name: "vlk_449_lares", scheme: "CHAIR", state: 1),
    SetCameraLocation(
        translation: (8, 6, 0),
        rotation: (-30.0, 90.0, 0.0),
    ),
    Wait(frame_dt: 50),

    // Assert
    TestLogExists(regex: "npc\\(.*\\) uses mob\\(.*\\) .*scheme\\(bsanvil\\)"),
    TestScreenshot(path: "00_harad_anvil.png"),
    SetCameraLocation(
        translation: (8, 6, -10),
        rotation: (-30.0, 90.0, 0.0),
    ),
    Wait(frame_dt: 50),
    TestLogExists(regex: "npc\\(.*\\) uses mob\\(.*\\) .*scheme\\(baumsaege\\)"),
    TestScreenshot(path: "01_thorben_saw.png"),
    SetCameraLocation(
        translation: (8, 6, -20),
        rotation: (-30.0, 90.0, 0.0),
    ),
    Wait(frame_dt: 50),
    TestLogExists(regex: "npc\\(.*\\) uses mob\\(.*\\) .*scheme\\(chair\\)"),
    TestScreenshot(path: "02_lares_chair.png"),

    ExitGame,
]
