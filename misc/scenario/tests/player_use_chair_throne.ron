[
    // Setup
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginLoadWorldPrototypes(world: "NEWWORLD/NEWWORLD"),
    ZenginSpawnVob(
        visual: "CHAIR_NW_NORMAL_01",
        translation: (0.0, 0.0, 0.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSpawnVob(
        visual: "THRONE_NW_CITY_01",
        translation: (0.0, 0.0, -10.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    SetCameraLocation(
        translation: (0.0, 0.0, 2.0),
        rotation: (-10.0, 0.0, 0.0),
    ),
    ZenginSetDebugNpc(name: "hero"),
    Wait(frame_dt: 10),

    // Act
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    SetCameraLocation(
        translation: (0.0, 0.0, 0.0),
        rotation: (-5.0, 90.0, 0.0),
    ),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "uses mob\\(.*\\) .*scheme\\(chair\\)"),
    TestScreenshot(path: "00_chair_side.png"),

    // Repeat
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 50),
    TestLogExists(regex: "Player\\(.*\\) released mob\\(.*\\)"),
    TeleportPlayer(
        translation: (3.0, 0.0, -10.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    SetCameraLocation(
        translation: (3.0, 0.0, -10.0),
        rotation: (-30.0, 0.0, 0.0),
    ),
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "visual_stem\\(.*\\) focus\\(MOBNAME_ARMCHAIR\\)"),
    SetCameraLocation(
        translation: (0.0, 0.0, 0.0),
        rotation: (-5.0, 90.0, 0.0),
    ),
    TestScreenshot(path: "01_throne_side.png"),

    ExitGame,
]
