        rotation: (-10.0, 0.0, 0.0),
    ),
    PressRelease(action: Editor(ToggleEditorMode)),

    // Sit on the plain chair.
    TestClearLogBuffer(frame_dt: 50),
    PressRelease(action: Gameplay(Interact)),
    TestLogExists(regex: "uses mob\\(.*\\) vob\\(TEST_MOB_CHAIR\\)"),
    SetCameraLocation(
        translation: (0.0, 0.0, 0.0),
        rotation: (-5.0, 90.0, 0.0),
    ),
    TestScreenshot(path: "00_chair_side.png"),

    PressRelease(action: Gameplay(Interact)),
    TestLogExists(frame_dt: 50, regex: "Player\\(.*\\) released mob\\(.*\\)"),
    TeleportPlayer(
        translation: (3.0, 0.0, -10.0),
        rotation: (0.0, 0.0, 0.0),
