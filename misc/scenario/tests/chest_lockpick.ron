[
    // Setup
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginLoadWorldPrototypes(world: "NEWWORLD/NEWWORLD"),
    ZenginSetDebugNpc(name: "hero"),
    ZenginSpawnVob(
        vob_id: 8877,
        translation: (0.0, 0.0, -2.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    Wait(frame_dt: 20),

    // Act
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 20),

    // Assert
    TestLogExists(regex: "started lockpicking chest"),
    TestLogNotExists(regex: "opened chest"),

    // Act
    PressRelease(action: Gui(CancelAction)),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "leaves chest|released mob"),

    // Act
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 20),
    PressRelease(action: Gui(Right)),
    Wait(frame_dt: 5),

    // Assert
    TestLogExists(regex: "Lockpick step was wrong"),

    // Act
    PressRelease(action: Gui(Left)),
    PressRelease(action: Gui(Right)),
    Wait(frame_dt: 20),

    // Assert
    TestLogExists(regex: "Lockpick of chest\\(.*\\) completed"),
    TestLogExists(regex: "opened lockpicked chest"),
    TestLogExists(regex: "Loot opened for chest"),

    // Repeat
    PressRelease(action: Gui(CancelAction)),
    Wait(frame_dt: 100),
    TestLogExists(regex: "leaves chest|released mob"),
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "opened chest"),
    TestLogNotExists(regex: "started lockpicking"),

    ExitGame,
]
