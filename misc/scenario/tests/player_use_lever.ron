// Player interaction with a lever (switch mob) in the bare test room.
//
// A switch-like vob must be usable: the player snaps on, plays the `S_LEVER_S1`
// pose, toggles the mob state, fires its trigger, and stands up automatically
// through `T_LEVER_S1_2_STAND` without a second `Interact`.
[
    TestWorld(name: "simple"),
    ZenginSpawnPlayerCharacter(frame: 10, translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSpawnMob(
        frame: 20,
        visual: "LEVER_1_OC",
        focus_name: "LEVER",
        translation: (0.0, 1.0, -2.0),
        rotation: (0.0, 180.0, 0.0),
    ),
    SetCameraLocation(
        frame: 30,
        translation: (0.0, 0.0, 0.0),
        rotation: (-30.0, 0.0, 0.0),
    ),
    Press(frame: 40, action: Editor(ToggleEditorMode)),
    Release(frame: 42, action: Editor(ToggleEditorMode)),

    ZenginSetDebugNpc(name: "hero"),
    TestClearLogBuffer(frame: 150),

    // `Interact` uses the lever.
    Press(frame: 170, action: Gameplay(Interact)),
    Release(frame: 172, action: Gameplay(Interact)),
    TestLogExists(frame: 200, regex: "uses mob\\(.*\\) vob\\(TEST_MOB_LEVER\\)"),
    TestLogExists(frame: 205, regex: "animation\\(S_LEVER_S1\\)"),
    // The use ends on its own: pose end -> `T_LEVER_S1_2_STAND` -> released.
    TestLogExists(frame: 330, regex: "auto-ends mob\\(.*\\) use, pose\\(S_LEVER_S1\\)"),
    TestLogExists(frame: 360, regex: "current=HUMANS-T_LEVER_S1_2_STAND"),
    TestLogExists(frame: 420, regex: "Player\\(.*\\) released mob\\(.*\\)"),
    Screenshot(frame: 430, path: "01_lever_used.png"),

    // Using the lever again toggles it back to state 0 and plays `S_LEVER_S0`.
    // There is no `T_LEVER_S0_2_STAND` in the archive, so that release falls
    // back to the standing idle immediately.
    TestClearLogBuffer(frame: 440),
    Press(frame: 450, action: Gameplay(Interact)),
    Release(frame: 452, action: Gameplay(Interact)),
    TestLogExists(frame: 485, regex: "animation\\(S_LEVER_S0\\)"),
    TestLogExists(frame: 500, regex: "-> state\\(0\\)"),
    TestLogExists(frame: 530, regex: "auto-ends mob\\(.*\\) use, pose\\(S_LEVER_S0\\)"),
    TestLogExists(frame: 560, regex: "Player\\(.*\\) released mob\\(.*\\)"),

    // Movement works right after the automatic stand-up.
    Axis(frame: 600, action: Gameplay(Move), value: (0.0, 1.0)),
    Axis(frame: 700, action: Gameplay(Move), value: (0.0, 0.0)),
    // Not compared: the synthetic lever mesh has no proper player `ZS_POS`, so
    // the pose position is test-mesh specific.
    Screenshot(frame: 710, path: "02_moved_away.png"),

    ExitGame(frame: 730),
]
