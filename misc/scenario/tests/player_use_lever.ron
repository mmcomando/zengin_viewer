// Player interaction with a lever (switch mob) in the bare test room.
//
// A switch-like vob must be usable: the player snaps on, plays the `S_LEVER_S1`
// pose, toggles the mob state, fires its trigger, and stands up automatically
// through `T_LEVER_S1_2_STAND` without a second `Interact`.
[
    TestWorld(name: "simple"),
    ZenginSpawnPlayerCharacter(frame_dt: 50, translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSpawnMob(
        visual: "LEVER_1_OC",
        focus_name: "LEVER",
        translation: (0.0, 1.0, -2.0),
        rotation: (0.0, 180.0, 0.0),
    ),
    SetCameraLocation(
        translation: (0.0, 0.0, 0.0),
        rotation: (-30.0, 0.0, 0.0),
    ),
    PressRelease(action: Editor(ToggleEditorMode)),

    ZenginSetDebugNpc(name: "hero"),
    TestClearLogBuffer(frame_dt: 50),

    // `Interact` uses the lever.
    PressRelease(action: Gameplay(Interact)),
    TestLogExists(frame_dt: 30, regex: "uses mob\\(.*\\) vob\\(TEST_MOB_LEVER\\)"),
    TestLogExists(regex: "animation\\(S_LEVER_S1\\)"),
    // The use ends on its own: pose end -> `T_LEVER_S1_2_STAND` -> released.
    TestLogExists(frame_dt: 125, regex: "auto-ends mob\\(.*\\) use, pose\\(S_LEVER_S1\\)"),
    TestLogExists(frame_dt: 30, regex: "current=HUMANS-T_LEVER_S1_2_STAND"),
    TestLogExists(frame_dt: 60, regex: "Player\\(.*\\) released mob\\(.*\\)"),
    Screenshot(path: "01_lever_used.png"),

    // Using the lever again toggles it back to state 0 and plays `S_LEVER_S0`.
    // There is no `T_LEVER_S0_2_STAND` in the archive, so that release falls
    // back to the standing idle immediately.
    TestClearLogBuffer(frame_dt: 10),
    PressRelease(frame_dt: 10, action: Gameplay(Interact)),
    TestLogExists(frame_dt: 35, regex: "animation\\(S_LEVER_S0\\)"),
    TestLogExists(frame_dt: 15, regex: "-> state\\(0\\)"),
    TestLogExists(frame_dt: 30, regex: "auto-ends mob\\(.*\\) use, pose\\(S_LEVER_S0\\)"),
    TestLogExists(frame_dt: 30, regex: "Player\\(.*\\) released mob\\(.*\\)"),

    // Movement works right after the automatic stand-up.
    Axis(frame_dt: 40, action: Gameplay(Move), value: (0.0, 1.0)),
    Axis(frame_dt: 100, action: Gameplay(Move), value: (0.0, 0.0)),
    // Not compared: the synthetic lever mesh has no proper player `ZS_POS`, so
    // the pose position is test-mesh specific.
    Screenshot(path: "02_moved_away.png"),

    ExitGame(frame_dt: 20),
]
