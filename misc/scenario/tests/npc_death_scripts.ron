[
    // Setup
    ZenginFilterSpawnWithPosition(points: [(center: (0, 0, 0), radius: 10.0)]),
    ZenginFilterNpcWithName(filters: ["wolf"]),
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginSpawnNpc(name: "wolf", translation: (0.0, 0.0, -3.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSetDebugNpc(name: "wolf"),
    ZenginSetPlayerAttribute(attribute: "strength", value: 100),
    ZenginSetPlayerFightSkill(talent: 1, value: 100),
    ZenginEquipWeapon(item: "itmw_1h_mil_sword"),
    Wait(frame_dt: 50),

    // Act
    TestClearLogBuffer,
    Press(action: Gameplay(DealDamage)),
    Wait(frame_dt: 600),
    Release(action: Gameplay(DealDamage)),

    // Assert
    TestLogExists(regex: "DebugNPC: death .* killer"),
    TestLogExists(regex: "DebugNPC: weapon .* sheathed"),
    TestLogExists(regex: "DebugNPC: animation .*current=WOLF-(T_DEAD|S_DEAD)"),
    TestScreenshot(path: "00_dead.png"),

    ExitGame,
]
