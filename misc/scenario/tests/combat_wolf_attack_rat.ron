[
    // Setup
    ZenginSetDebugNpc(name: "wolf, rat"),
    ZenginFilterNpcWithName(filters: ["ygiant_rat"]),
    ZenginFilterNpcWithName(filters: ["ywolf"]),
    ZenginFilterSpawnWithPosition(points: [(center: (-261, 8, -125), radius: 20.0)]),
    IncludeScenario(path: "/common/new_world"),
    SetCameraLocation(
        translation: (-256, 15, -130),
        rotation: (-80, 0.0, 0.0),
    ),
    // Act
    TestClearLogBuffer,
    Wait(frame_dt: 300),

    // Assert
    TestLogExists(regex: "DebugNPC: actions GoToNpc\\(target="),
    TestLogExists(regex: "DebugNPC: actions Attack\\(target="),
    TestLogExists(regex: "DebugNPC: animation .*current=WOLF-S_FISTATTACK next=- root_motion=true"),
    TestLogExists(regex: "hitpoints now 0"),

    ExitGame,
]
