[
    // Setup
    IncludeScenario(path: "/common/test_room_player_pov"),
    ZenginLoadWorldPrototypes(world: "NEWWORLD/NEWWORLD"),
    ZenginSpawnVob(
        visual: "BSFIRE_OC",
        translation: (0.0, 0.0, -2.0),
        rotation: (0.0, 180.0, 0.0),
    ),
    ZenginSpawnVob(
        visual: "BOOK_NW_CITY_CUPBOARD_01",
        translation: (0.0, 1.336, -12.0),
        rotation: (0.0, 180.0, 0.0),
    ),
    SetCameraLocation(
        translation: (0.0, 0.0, 2.0),
        rotation: (-10.0, 0.0, 0.0),
    ),
    ZenginSetDebugNpc(name: "hero"),
    Wait(frame_dt: 10),

    // Act
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "uses mob\\(.*\\) .*scheme\\(bsfire\\)"),
    TestLogExists(regex: "focus\\(MOBNAME_FORGE\\)"),
    TestScreenshot(path: "00_forge_used.png"),

    // Release
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 150),
    TestLogExists(regex: "Player\\(.*\\) released mob\\(.*\\)"),

    // Repeat
    TeleportPlayer(
        translation: (3.0, 0.0, -12.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    SetCameraLocation(
        translation: (3.0, 0.0, -12.0),
        rotation: (-30.0, 0.0, 0.0),
    ),
    Wait(frame_dt: 20),
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 100),

    // Assert
    TestLogExists(regex: "uses mob\\(.*\\) .*scheme\\(book\\)"),
    TestLogExists(regex: "focus\\(MOBNAME_BOOKSBOARD\\)"),
    TestScreenshot(path: "01_bookboard_used.png"),

    ExitGame,
]
