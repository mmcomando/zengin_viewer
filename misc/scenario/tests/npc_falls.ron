[
    // Setup
    ZenginFilterNpcWithName(filters: ["lares"]),
    IncludeScenario(path: "/common/test_room_free_camera"),
    ZenginSpawnNpc(
        name: "vlk_449_lares",
        translation: (0.0, 20.0, -3.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    ZenginSetDebugNpc(name: "lares"),

    // Act
    TestClearLogBuffer,
    Wait(frame_dt: 70),

    // Assert
    TestLogExists(regex: "DebugNPC: state position=\\(0\\.00, 1[0-9]\\.[0-9]+, -3\\.00\\)"),
    Wait(frame_dt: 300),
    TestLogExists(regex: "DebugNPC: state position=\\(0\\.00, 0\\.0[0-9], -3\\.00\\)"),

    ExitGame,
]
