// Player interaction with a chair mob in the bare test room.
//
// The chair is spawned from the game's own mesh (`CHAIR_NW_NORMAL_01`) next to
// the player, so the whole player-side mob flow (selection label, `Interact`
// attach with the `S_CHAIR_S1` pose, stand-up) can be checked without loading a
// world.
[
    TestWorld(name: "simple"),
    Wait(frame_dt: 50),
    ZenginSpawnPlayerCharacter(translation: (0.0, 0.0, 0.0), rotation: (0.0, 0.0, 0.0)),
    ZenginSpawnMob(
        visual: "CHAIR_NW_NORMAL_01",
        focus_name: "CHAIR",
        translation: (0.0, 0.0, -2.0),
        rotation: (0.0, 0.0, 0.0),
    ),
    // Replays start in editor mode (free camera); leaving it enables gameplay
    // input. The player is then placed back in front of the chair.
    SetCameraLocation(
        translation: (0.0, 0.0, 0.0),
        rotation: (-30.0, 0.0, 0.0),
    ),
    PressRelease(action: Editor(ToggleEditorMode)),
    ZenginSetDebugNpc(name: "hero"),

    // The chair is in selection range and shows its focus name.
    Wait(frame_dt: 50),
    TestScreenshot(path: "00_chair.png"),

    // `Interact` snaps the player onto the chair and plays `S_CHAIR_S1`.
    TestClearLogBuffer,
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 50),
    TestLogExists(regex: "uses mob\\(.*\\) vob\\(TEST_MOB_CHAIR\\)"),
    TestLogExists(regex: "-> state\\(1\\)"),
    TestScreenshot(path: "01_used.png"),

    // A second `Interact` stands the player up.
    PressRelease(action: Gameplay(Interact)),
    Wait(frame_dt: 30),
    TestLogExists(regex: "Player\\(.*\\) released mob\\(.*\\)"),
    TestScreenshot(path: "02_released.png"),

    // Movement to make sure player detached.
    Axis(action: Gameplay(Move), value: (0.0, 1.0)),
    Wait(frame_dt: 200),
    Axis(action: Gameplay(Move), value: (0.0, 0.0)),
    TestScreenshot(path: "03_moved_away.png"),

    ExitGame,
]
