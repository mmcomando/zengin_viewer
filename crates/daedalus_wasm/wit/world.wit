interface manage {
    enum symbol-kind {
        float,
        int,
        str,
        class,
        function,
        prototype,
        instance,
        variable-argument,
    }
    // Info from c_info daedalus class
    record dialog-info {
        npc: s32,
        order: s32,
        condition: s32,
        information: s32,
        description: s32,
        important: bool,
        permanent: bool,
        trade: bool,
    }
    // Generic info about symbol
    record symbol-info {
        kind: symbol-kind,
        parent: option<s32>,
        function: option<s32>,
    }

    record npc-info {
        hitpoints: s32,
        hitpoints-max: s32,
        name: option<s32>,
    }
    record item-info {
        damage-total: s32,
        name: option<s32>,
        value: s32,
        weight: s32,
        cond-attribute: list<s32>,
        cond-value: list<s32>,
        description: option<s32>,
        text: list<s32>,
        count: list<s32>,
    }
    // Info from c_menu daedalus class
    record menu-info {
        back-pic: option<s32>,
        back-world: option<s32>,
        pos-x: s32,
        pos-y: s32,
        dim-x: s32,
        dim-y: s32,
        alpha: s32,
        music-theme: option<s32>,
        event-timer-msec: s32,
        items: list<s32>,
        menu-flags: s32,
        default-out-game: s32,
        default-in-game: s32,
    }
    // Info from c_menu_item daedalus class
    record menu-item-info {
        font-name: option<s32>,
        text: list<s32>,
        back-pic: option<s32>,
        alpha-mode: option<s32>,
        alpha: s32,
        kind: s32,
        on-sel-action: list<s32>,
        on-sel-action-s: list<s32>,
        on-chg-set-option: option<s32>,
        on-chg-set-option-section: option<s32>,
        on-event-action: list<s32>,
        pos-x: s32,
        pos-y: s32,
        dim-x: s32,
        dim-y: s32,
        item-flags: s32,
    }


    test-func: func() -> s32;
    set-instance: func(instance-id: s32);
    set-self: func(instance-id: s32);
    set-other: func(instance-id: s32);
    set-victim: func(instance-id: s32);
    set-item: func(instance-id: s32);
    set-hero: func(instance-id: s32);
    call-npc-routine: func(instance-id: s32);
    get-name: func(symbol-id: s32) -> string;
    call-function: func(symbol-id: s32);
    call-function-discard: func(symbol-id: s32);
    call-function-bool: func(symbol-id: s32) -> bool;
    get-symbol-id: func(symbol-name: string) -> option<s32>;
    get-menu-info: func(symbol-id: s32) -> menu-info;
    get-menu-item-info: func(symbol-id: s32) -> menu-item-info;
    get-item-visual: func(symbol-id: s32) -> option<string>;
    get-item-visual-change: func(symbol-id: s32) -> option<string>;
    get-npc-info: func(symbol-id: s32) -> npc-info;
    get-item-info: func(symbol-id: s32) -> item-info;
    initialize-all-instances: func();
    get-all-symbols-num: func() -> s32;
    get-all-strings-num: func() -> s32;
    get-dialog-info: func(symbol-id: s32) -> dialog-info;
    get-symbol-info: func(symbol-id: s32) -> symbol-info;
}

world mm-world {
    import scripts;
    export manage;
}
