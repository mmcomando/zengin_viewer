    wld-insertitem: func(v-0: s32, v-1: s32);
    wld-insertnpc: func(v-0: s32, v-1: s32);
    wld-insertnpcandrespawn: func(v-0: s32, v-1: s32, v-2: s32);
    wld-insertobject: func(v-0: s32, v-1: s32);
    wld-isfpavailable: func(v-0: s32, v-1: s32) -> s32;
    wld-ismobavailable: func(v-0: s32, v-1: s32) -> s32;
    wld-isnextfpavailable: func(v-0: s32, v-1: s32) -> s32;
    wld-israining: func() -> s32;
    wld-istime: func(v-0: s32, v-1: s32, v-2: s32, v-3: s32) -> s32;
    wld-playeffect: func(v-0: s32, v-1: s32, v-2: s32, v-3: s32, v-4: s32, v-5: s32, v-6: s32);
    wld-removeitem: func(v-0: s32) -> s32;
    wld-removenpc: func(v-0: s32);
    wld-sendtrigger: func(v-0: s32);
    wld-senduntrigger: func(v-0: s32);
    wld-setguildattitude: func(v-0: s32, v-1: s32, v-2: s32);
    wld-setmobroutine: func(v-0: s32, v-1: s32, v-2: s32, v-3: s32);
    wld-setobjectroutine: func(v-0: s32, v-1: s32, v-2: s32, v-3: s32);
    wld-settime: func(v-0: s32, v-1: s32);
    wld-spawnnpcrange: func(v-0: s32, v-1: s32, v-2: s32, v-3: s32);
    wld-stopeffect: func(v-0: s32);
}
interface manage {
    enum symbol-kind {
        float,
        int,
        str,
        class,
        function,
        prototype,
        instance,
        variable-argument,
    }
    // Info from c_info daedalus class
    record dialog-info {
        npc: s32,
        order: s32,
        condition: s32,
        information: s32,
        description: s32,
        important: bool,
        permanent: bool,
    }
    // Generic info about symbol
    record symbol-info {
        kind: symbol-kind,
        parent: option<s32>,
        function: option<s32>,
    }

    record npc-info {
        hitpoints: s32,
        hitpoints-max: s32,
        name: option<s32>,
    }
    record item-info {
        damage-total: s32,
        name: option<s32>,
        value: s32,
        weight: s32,
        cond-attribute: list<s32>,
        cond-value: list<s32>,
        description: option<s32>,
        text: list<s32>,
        count: list<s32>,
    }


    test-func: func() -> s32;
    set-instance: func(instance-id: s32);
    set-self: func(instance-id: s32);
    set-other: func(instance-id: s32);
    set-victim: func(instance-id: s32);
    set-item: func(instance-id: s32);
    set-hero: func(instance-id: s32);
    call-npc-routine: func(instance-id: s32);
    get-name: func(symbol-id: s32) -> string;
    call-function: func(symbol-id: s32);
    call-function-bool: func(symbol-id: s32) -> bool;
    get-symbol-id: func(symbol-name: string) -> option<s32>;
    get-item-visual: func(symbol-id: s32) -> option<string>;
    get-item-visual-change: func(symbol-id: s32) -> option<string>;
    get-npc-info: func(symbol-id: s32) -> npc-info;
    get-item-info: func(symbol-id: s32) -> item-info;
    initialize-all-instances: func();
    get-all-symbols-num: func() -> s32;
    get-all-strings-num: func() -> s32;
    get-dialog-info: func(symbol-id: s32) -> dialog-info;
    get-symbol-info: func(symbol-id: s32) -> symbol-info;
}

world mm-world {
    import scripts;
    export manage;
}
